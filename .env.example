# NABD — Vercel environment variables (copy to .env for local `vercel dev`, or
# set in the Vercel project dashboard). NEVER commit .env / real secrets.

# PostgreSQL connection string (required for auth/database-backed routes)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional Postgres pool tuning
PG_POOL_MAX=5

# SMTP for transactional email (email-verification OTP).
# When SMTP_HOST/PORT are unset the backend falls back to console logging
# (dev mode) so the signup flow stays usable locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=NABD <no-reply@nabd.app>

# AES-256 secret-at-rest key (used to encrypt Facebook tokens). >=16 chars.
AUTH_SECRET=

# n8n production webhook — the single analysis endpoint
NABD_WEBHOOK_URL=https://n8n.addme.solutions/webhook/trend-analysis

# Meta (Facebook) app used for the private-account OAuth flow.
# App Secret stays server-side — it is only used inside api/meta/callback.js.
META_APP_ID=
META_APP_SECRET=
# Absolute URL of the deployed callback route, e.g.
# https://your-project.vercel.app/api/meta/callback
META_REDIRECT_URI=
# Optional: page id to analyze when the connected account manages several
# pages. Leave empty to use the first page Meta returns.
META_DEFAULT_PAGE_ID=
